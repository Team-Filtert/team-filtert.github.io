package pages

import (
	"github.com/LukasDerBaum42/astwerk/ssg"
	"github.com/Team-Filtert/Webside/templates"
)

templ About(c ssg.Ctx) {
	@templates.Layout(c, templates.Meta{
		Title:       "About the game",
		Description: "The story, characters, and world of Neuro-sama: The Good, The Evil And The Filtered.",
	}, nil) {
		<header class="story">
			<h1>About the game</h1>
			<h2>The story (summary)</h2>
			<p>
				Neuro-sama: The Good, The Evil And The Filtered is an ambitious JRPG
				fan project featuring Neuro-sama and all of your favourite VTubers.
				Nere (the embodiment of the twins' filter) has been let loose by a
				drunk Vedal and is going on a rampage filtering everyone in the
				Neuroverse! The twins set off across 7 unique worlds to try and stop
				Nere from filtering all of their friends. Some VTubers are acting
				strange, perhaps this is a side effect of Nere's corruption? Find
				out the full story as more content gets released!
			</p>
			<h2>Description</h2>
			<p>
				The game will have 8 chapters, each with their own cast of
				characters and VTubers. The world is rife with challenges and
				mysteries to solve with each chapter having a vastly different
				environment from the last. Combat and exploration will feel snappy
				and unique, drawing inspiration from various other titles. We want
				to create a rich experience that fans and VTubers alike can immerse
				themselves into. The gameplay, the visuals, the music, it's all
				developed by passionate and talented people to make the game feel as
				high quality as any other indie RPG game. Once the full game
				releases we plan to add more via postgame and free DLC. Please stay
				tuned for more updates!

				<br/>
				<br/>
				note from Lukas: Wolfy might be exaggerating
			</p>
		</header>

		<section>
			<h2>Characters</h2>
			<p>Meet some of the many Vtubers and Streamers featured in the game</p>
			<div class="characters">
				<div class="b_card">
					<div class="card_h">
						<img src={ c.Asset("img/characters/Neuro_pfp.jpg") } alt="Neuro character art"/>
						<h2>Neuro</h2>
					</div>
					<h3>Main Character</h3>
					<p>Neuro is one of the main characters</p>
				</div>
				<div class="b_card">
					<div class="card_h">
						<img src={ c.Asset("img/characters/Evil_pfp.jpg") } alt="Evil character art"/>
						<h2>Evil</h2>
					</div>
					<h3>Main Character</h3>
					<p>Evil is the other main character</p>
				</div>

				<div class="b_card">
					<div class="card_h">
						<img src={ c.Asset("img/characters/nere.jpg") } alt="Nere character art"/>
						<h2>Nere</h2>
					</div>
					<h3>Main Villain</h3>
					<p>Nere is the main villain, the twins have to stop</p>
					<p class="art-credit">Art credits: @TroobsART on twitter</p>
				</div>

				<div class="b_card">
					<div class="card_h">
						<img src={ c.Asset("img/characters/Vedal.png") } alt="Vedal character art"/>
						<h2>Vedal</h2>
					</div>
					<h3>???</h3>
					<p>???</p>
				</div>

				<div class="b_card">
					<div class="card_h">
						<img src={ c.Asset("img/characters/Crelly.png") } alt="Crelly character art"/>
						<h2>Crelly</h2>
					</div>
					<h3>Companion</h3>
					<p>Crelly is one of the companions that will help Neuro and Evil</p>
				</div>

				<div class="b_card">
					<div class="card_h">
						<img src={ c.Asset("img/characters/Ellie.jpg") } alt="Ellie character art"/>
						<h2>Ellie</h2>
					</div>
					<h3>Companion</h3>
					<p>Ellie is one of the companions that will help Neuro and Evil</p>
				</div>
			</div>
		</section>
	}
}
