package pages

import (
	"github.com/LukasDerBaum42/astwerk/ssg"
	"github.com/Team-Filtert/Webside/templates"
)

templ NotFound(c ssg.Ctx) {
	@templates.Layout(c, templates.Meta{
		Title:       "Page not found",
		Description: "The path seems to have been FILTERED.",
	}, nil) {
		<script>
			const { pathname } = window.location;
			if (pathname.endsWith(".html")) {
				window.location.href = pathname.slice(0, pathname.length - 5);
			}
		</script>
		<header class="story">
			<h1>404 File Not Found</h1>
			<h2>The path seems to have been FILTERED.</h2>
			<p>
				Try re-navigating from our <a href={ c.Link("") }>homepage</a>.
			</p>
		</header>
	}
}
