package pages

import (
	"github.com/LukasDerBaum42/astwerk/ssg"
	"github.com/Team-Filtert/Webside/templates"
)

templ Contact(c ssg.Ctx) {
	@templates.Layout(c, templates.Meta{
		Title:       "Contact",
		Description: "Where to find Team Filtered on YouTube, Twitter, Discord, GitHub, and by email.",
	}, contactStyles()) {
		<section class="contact">
			<h2>Where you can find us</h2>
			<div class="contact-info">
				<div class="Youtube-links">
					<h3>
						<img src={ c.Asset("assets/logos/youtube.svg") } alt="YouTube logo"/>
						<span>YouTube</span>
					</h3>
					<a href="https://www.youtube.com/@TeamFiltered" target="_blank" rel="noopener noreferrer">Team Filtered</a>
					<a href="https://www.youtube.com/@CountWolfy" target="_blank" rel="noopener noreferrer">Count Wolfy</a>
					<a href="https://youtube.com/@LukasDerBaum" target="_blank" rel="noopener noreferrer">Lukas DerBaum</a>
					<a href="https://www.youtube.com/@RikoTanaki127" target="_blank" rel="noopener noreferrer">Riko</a>
					<a href="https://www.youtube.com/channel/UCXB_oJQHTIf5wX1y4E8fDpw" target="_blank" rel="noopener noreferrer">The Swarm Scribes</a>
					<a href="https://youtube.com/@KTrain5369" target="_blank" rel="noopener noreferrer">KTrain</a>
				</div>
				<div class="Twitter-links">
					<h3>
						<img src={ c.Asset("assets/logos/twitter.svg") } alt="Twitter logo"/>
						<span>Twitter</span>
					</h3>

					<a href="https://x.com/@Teamfilteredf" target="_blank" rel="noopener noreferrer">Team Filtered</a>
					<a href="https://x.com/CountWolfy" target="_blank" rel="noopener noreferrer">CountWolfy</a>
					<a href="https://x.com/@DerbaumLuk37729" target="_blank" rel="noopener noreferrer">Lukas DerBaum</a>
					<a href="https://x.com/Anzeal14" target="_blank" rel="noopener noreferrer">Anzeal</a>
					<a href="https://x.com/FireArchers_" target="_blank" rel="noopener noreferrer">FireArchers</a>
					<a href="https://x.com/lokt0234maybw" target="_blank" rel="noopener noreferrer">Lokt</a>
					<a href="https://x.com/RikoTanaki127" target="_blank" rel="noopener noreferrer">Riko</a>
					<a href="https://x.com/R_Addical" target="_blank" rel="noopener noreferrer">Mak</a>
				</div>
				<div class="discord-links">
					<h3>
						<img
							src={ c.Asset("assets/logos/discord-svgrepo-com.svg") }
							alt="Discord logo"
						/>
						<span>Discord</span>
					</h3>

					<a href="https://discord.gg/nAXzxMY9gT" target="_blank" rel="noopener noreferrer">Our Discord server</a>
					<a href="https://discord.com/invite/TzMX6mgHNP" target="_blank" rel="noopener noreferrer">The Swarm Scribes</a>
				</div>
				<div class="github-links">
					<h3>
						<img
							src={ c.Asset("assets/logos/github-142-svgrepo-com.svg") }
							alt="GitHub logo"
						/>
						<span>GitHub</span>
					</h3>

					<a href="https://github.com/Team-Filtert" target="_blank" rel="noopener noreferrer">Our GitHub Org</a>
					<a href="https://github.com/Team-Filtert/Webside" target="_blank" rel="noopener noreferrer">This Website</a>
					<a href="https://github.com/KTrain5169" target="_blank" rel="noopener noreferrer">KTrain</a>
					<a href="https://github.com/LukasDerBaum42" target="_blank" rel="noopener noreferrer">LukasDerBaum</a>
				</div>
				<div>
					<h3>
						<img src={ c.Asset("assets/logos/email.svg") } alt="Email logo"/>
						<span>Email</span>
					</h3>

					<p>teamfilteredo7@gmail.com</p>
				</div>
			</div>
		</section>
	}
}

templ contactStyles() {
	<style>
		.contact-info {
				display: flex;
				flex-wrap: wrap;
				gap: 2.5rem;
				align-items: center;
			}

			.contact-info h3 {
				display: flex;
				text-align: center;
				align-items: center;
				margin-left: auto;
				margin-right: auto;
				gap: 1rem;
				opacity: 1;
			}

			.contact-info img {
				width: 2rem;
				height: 2rem;
				object-fit: contain;
				display: block;
				filter: invert(1);
				opacity: 1;
			}

			.contact-info div {
				background: rgba(25, 27, 38, 0.4);
				max-width: 50%;
				margin-left: auto;
				margin-right: auto;
				min-width: 30%;
				display: grid;
				gap: 0.7rem;
				padding: 0.5rem;
				border-radius: 1rem;
				grid-template-columns: repeat(auto-fit);
				align-items: center;
				transition: background 0.3s ease, box-shadow 0.3s ease;
			}

			.contact-info div:hover {
				transition: background 0.3s ease, box-shadow 0.3s ease;
				background: rgba(25, 27, 38, 1);
				box-shadow: 0 8px 20px rgba(0, 0, 0, 0.6);
			}

			.contact-info a {
				color: #eee;
				padding: 0.3rem;
				max-height: 1.6rem;
				margin-left: 0.5rem;
				margin-right: 0.5rem;
				font-weight: bold;
				text-align: center;
				text-decoration: none;
				border-radius: 1rem;
				box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
				opacity: 1;
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					color 0.2s ease;
			}

			.contact-info p {
				color: #eee;
				padding: 0.3rem;
				max-height: 1.6rem;
				margin-left: 0.5rem;
				margin-right: 0.5rem;
				font-weight: bold;
				text-align: center;
				text-decoration: none;
				border-radius: 1rem;
				opacity: 1;
			}

			.contact-info a:hover {
				color: #ddd;
				padding: 0.3rem;
				max-height: 1.6rem;
				transform: translateY(-0.1rem);
				box-shadow: 0 8px 20px rgba(0, 0, 0, 0.6);
				transition:
					transform 0.2s ease,
					box-shadow 0.2s ease,
					color 0.2s ease;
			}

			.Youtube-links a {
				background: #ff0000;
			}

			.Youtube-links a:hover {
				background: #d01010;
			}

			.Twitter-links a {
				background: #1da1f2;
			}

			.Twitter-links a:hover {
				background: #2db1d2;
			}

			.discord-links a {
				background: #7289d7;
			}

			.discord-links a:hover {
				background: #8299f7;
			}

			.github-links a {
				background: #333333;
			}

			.github-links a:hover {
				background: #666666;
			}

			.itchio-links a {
				background: #fa5c5c;
			}

			.itchio-links a:hover {
				background: #da6c6c;
			}

			@media (max-width: 720px) {
				.contact-info {
					gap: 1rem;
				}

				.contact-info div {
					max-width: 100%;
					min-width: 100%;
				}
			}
		</style>
}
