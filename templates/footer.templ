package templates

import "github.com/LukasDerBaum42/astwerk/ssg"

templ Footer(c ssg.Ctx) {
	<footer>
		<div class="footer-div">
			<p class="footer-slogan">
				Made by people with questionable sleep schedules.
			</p>
			<div class="footer-divider">
				<div>
					<a href={ c.Link("") }>Home Page</a>
					<ul>
						<li><a href={ c.Link("") + "#hero" }>Top of page</a></li>
						<li><a href={ c.Link("") + "#about" }>About the game</a></li>
						<li><a href={ c.Link("") + "#team" }>The team</a></li>
						<li><a href={ c.Link("") + "#posters" }>Posters</a></li>
						<li><a href={ c.Link("") + "#updates" }>Dev logs</a></li>
					</ul>
				</div>
				<div>
					<a href={ c.Link("contact/") }>Contact us at</a>
					<ul>
						<li>teamfilteredo7@gmail.com</li>
						<li>
							<a href="https://www.youtube.com/@TeamFiltered" target="_blank" rel="noopener noreferrer">YouTube</a>
						</li>
						<li>
							<a href="https://www.x.com/@Teamfilteredf" target="_blank" rel="noopener noreferrer">Twitter</a>
						</li>
					</ul>
				</div>
				<div>
					<a href={ c.Link("team/") }>Meet the team</a>
					<ul>
						<li><a href={ c.Link("team/") + "#member-wolfy" }>CountWolfy</a></li>
						<li><a href={ c.Link("team/") + "#member-lukas" }>Lukas</a></li>
						<li><a href={ c.Link("team/") + "#member-riko" }>Riko</a></li>
						<li><a href={ c.Link("team/") + "#member-admiralensin" }>AdmiralEnsin</a></li>
						<li><a href={ c.Link("team/") + "#member-komi" }>Komikron</a></li>
						<li><a href={ c.Link("team/") + "#member-firearchers" }>Firearchers</a></li>
					</ul>
				</div>
				<div class="footer-updates">
					<a href={ c.Link("updates/") }>Updates Blog</a>
					<ul>
						for _, update := range footerUpdates {
							<li>
								<a href={ c.Link("updates/" + update.Slug + "/") }>{ update.Title }</a>
							</li>
						}
					</ul>
				</div>
				<div>
					<a href={ c.Link("credits/") }>Credits</a>
					<ul>
						for _, tag := range Assets().Tags() {
							<li>
								<a href={ c.Link("credits/") + "#" + tag }>{ tag }</a>
							</li>
						}
					</ul>
				</div>
			</div>
			<p class="footer-copyright">
				<img
					src={ c.Asset("img/team_filtered_logo.png") }
					alt="Team Filtered logo"
				/> &copy; 2026 Team Filtered distributed under MIT License
			</p>
		</div>
	</footer>
}

// FooterStyles is rendered at the bottom of the layout, after the markup it
// styles. Templ styles are global, so keeping it in one place makes that
// explicit.
templ FooterStyles() {
	<style>
		footer {
			position: relative;
			z-index: 1;
			margin-top: clamp(3rem, 7vw, 6rem);
			border-top: 1px solid var(--border);
			background: var(--surface);
		}

		.footer-div {
			width: 100%;
			padding: clamp(2rem, 4vw, 3rem) clamp(1rem, 4vw, 3rem) 1.5rem;
		}

		.footer-slogan {
			margin: 0 auto clamp(1.75rem, 4vw, 2.5rem);
			color: var(--green);
			font-family: var(--font-pixel);
			font-size: clamp(0.5rem, 1.2vw, 0.65rem);
			line-height: 2;
			text-align: center;
		}

		.footer-divider {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
			align-items: start;
			gap: 2rem;
			padding-bottom: 2rem;
			border-bottom: 1px solid var(--border);
		}

		.footer-divider ul {
			display: flex;
			flex-direction: column;
			gap: 0.35rem;
			margin: 0.65rem 0 0;
			padding: 0;
			list-style: none;
		}

		.footer-divider > div > a {
			display: block;
			color: var(--green);
			font-family: var(--font-display);
			font-size: 1.15rem;
			font-weight: 700;
			text-decoration: none;
		}

		.footer-divider > div > a:hover {
			color: var(--mint);
		}

		.footer-divider li,
		.footer-divider li a {
			color: var(--muted);
			font-size: 0.88rem;
			line-height: 1.5;
		}

		.footer-divider li a {
			text-decoration: none;
			transition: color 0.2s ease;
		}

		.footer-divider li a:hover {
			color: var(--green);
			text-decoration: none;
		}

		.footer-updates {
			max-width: none;
		}

		.footer-copyright {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.6rem;
			margin: 1.5rem 0 0;
			color: var(--muted);
			font-size: 0.78rem;
			text-align: center;
		}

		.footer-copyright img {
			width: 2.5rem;
			height: auto;
		}

		@media (max-width: 720px) {
			.footer-divider {
				grid-template-columns: 1fr 1fr;
				gap: 1.5rem;
			}
		}

		@media (max-width: 480px) {
			.footer-divider {
				grid-template-columns: 1fr;
			}

			.footer-copyright {
				flex-direction: column;
			}
		}
	</style>
}
